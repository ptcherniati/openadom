SERVER_PORT=8081
SERVER_SERVLET-PATH=/services
DB_HOST_PORT=localhost:5432
DB_DATABASE=openadom
DB_USER=dbuser
DB_PASSWORD=xxxxxxxx
SPRING_FLYWAY_PLACEHOLDERS_PUBLIC-ROLE-ID=9032ffe5-bfc1-453d-814e-287cd678484a
LOGGING_LEVEL_FR-INRA-ORESING=DEBUG
SPRING_SERVLET_MULTIPART_MAXFILESIZE=200MB
SPRING_SERVLET_MULTIPART_MAXREQUESTSIZE=200MB
SPRING_SERVLET_ENCODING_CHARSET=UTF-8
SPRING_SERVLET_ENCODING_FORCE=true
MANAGEMENT_ENDPOINT_HEALTH_ENABLED=true
MANAGEMENT_ENDPOINT_WEB_EXPOSURE_INCLUDE=health
SWAGGER-UI-URI=http://localhost:8081
FILE_SENDER_BASE_URL=https://filesender.renater.fr/rest.php
FILE_SENDER_USER_NAME=mail@user.fr
FILE_SENDER_API_KEY=an_api_key
VIEW_STRATEGY=VIEW
SPRING_MAIL_HOST=smtp.server.fr
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=username
SPRING_MAIL_PASSWORD=password
MAIL_FROM=openadom@server.fr
SPRING_MAIL_TEST-CONNECTION=false
SPRING_MAIL_SMTP_STARTSSL_ENABLE=true
SPRING_MAIL_SMTP_STARTSSL_REQUIRED=true
SPRING_DATASOURCE_HIKARI_CONNNECTION-TIMEOUT=20000
SPRING_DATASOURCE_HIKARI_MINIMUM-IDLE=10
SPRING_DATASOURCE_HIKARI_MAXIMUM-POOL-SIZE=500
SPRING_DATASOURCE_HIKARI_IDLE-TIMEOUT=10000
SPRING_DATASOURCE_HIKARI_MAX-LIFETIME=1800000
SPRING_DATASOURCE_HIKARI_AUTO-COMMIT=true
# --- Pipeline Cascade (R-P0-1 / T2) ------------------------------------------
# Parallelisme workers CSV-DB (adapter selon le nombre de coeurs disponibles).
# Defaut prudent : 4 (production safe). Sur les machines dev, augmenter.
CASCADE_IMPORT_PARALLELISM=4
# Taille de chunk CSV par defaut (lignes par lot de traitement).
CASCADE_IMPORT_CHUNK-SIZE-LINES=1000
# Seuil d'abandon si trop d'erreurs dans un fichier.
CASCADE_IMPORT_MAX-ERRORS-THRESHOLD=100
# Mode recursion ordonnee globale (false = comportement historique).
# Peut aussi etre active par datatype via le tag YAML __ORDER_STRICT__.
CASCADE_IMPORT_ORDERED-RECURSION-MODE=false
# Taille max du cache de validation de reference (R-P2-2, non actif avant P2).
CASCADE_IMPORT_REFERENCE-CACHE-MAX-ENTRIES=5000
# Taille max du cache de resultats Groovy (R-P2-4, non actif avant P2).
CASCADE_IMPORT_GROOVY-CACHE-MAX-ENTRIES=1000
# --- Migration securisation (R-P1-2) -----------------------------------------
# true = comportement historique (bypass validations de compatibilite).
# Passer a false en production pour bloquer les mises a jour incompatibles.
OPENADOM_MIGRATION_BYPASS-CONFIGURATION-CHECK=true
# --- HikariCP (connexion DB) --------------------------------------------------
# Calibrer selon : parallelism + Spring threads + Flyway + marge = pool-size
# Regle de base : pool-size = parallelism + 5
SPRING_DATASOURCE_HIKARI_MINIMUM-IDLE=5
SPRING_DATASOURCE_HIKARI_MAXIMUM-POOL-SIZE=20
SPRING_DATASOURCE_HIKARI_LEAK-DETECTION-THRESHOLD=0
# --- Threads Spring (executors async) ----------------------------------------
# heavy : imports CSV longs
EXECUTOR_HEAVY_CORE_POOL_SIZE=2
EXECUTOR_HEAVY_MAX_POOL_SIZE=4
# normal : operations moderees
EXECUTOR_NORMAL_CORE_POOL_SIZE=2
EXECUTOR_NORMAL_MAX_POOL_SIZE=4
# fast : operations courtes (notifications, cache)
EXECUTOR_FAST_CORE_POOL_SIZE=4
EXECUTOR_FAST_MAX_POOL_SIZE=8
