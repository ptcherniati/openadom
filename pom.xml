    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/application.properties</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>src/main/resource**/application.properties</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>get-the-git-infos</id>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                </executions>
                <configuration>
                    <generateGitPropertiesFile>true</generateGitPropertiesFile>
                    <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties
                    </generateGitPropertiesFilename>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>--enable-preview</compilerArgs>
                    <release>${java.version}</release>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-resources</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/src/resources/monsore-upload-bundle</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/resources/fr/inra/oresing/client</directory>
                                    <includes>
                                        <include>OpenAdomClient.groovy</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version> <!-- Version explicite importante -->
                <executions>
                    <execution>
                        <id>resolve-mockito-path</id>
                        <phase>initialize</phase> <!-- Phase explicite -->
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        @{argLine}
                        -javaagent:"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"

                    </argLine>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <configuration>
                    <ignoredVersions>.*-M.*,.*-alpha.*,.*-beta.*</ignoredVersions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>cz.habarta.typescript-generator</groupId>
                <artifactId>typescript-generator-maven-plugin</artifactId>
                <version>3.2.1263</version>
                <executions>
                    <execution>
                        <id>generate-backend-types</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <jsonLibrary>jackson2</jsonLibrary>
                            <outputKind>module</outputKind>
                            <outputFileType>implementationFile</outputFileType>
                            <classes>
                                <class>fr.inra.oresing.rest.model.application.ApplicationResult</class>
                                <class>fr.inra.oresing.rest.model.rightsrequest.GetAdditionalFilesResult</class>
                                <class>fr.inra.oresing.rest.model.authorization.GetAuthorizationResult</class>
                                <class>fr.inra.oresing.rest.model.authorization.LoginAdminResult</class>
                                <class>fr.inra.oresing.domain.OreSiUser</class>
                                <class>fr.inra.oresing.rest.model.authorization.CreateAdditionalFileAuthorizationRequest</class>
                                <class>fr.inra.oresing.rest.model.data.query.DownloadDatasetQuery</class>
                                <class>fr.inra.oresing.rest.model.data.BinaryFileResult</class>
                                <class>fr.inra.oresing.rest.CreateUserResult</class>
                                <class>fr.inra.oresing.rest.CreateUserRequest</class>
                                <class>fr.inra.oresing.domain.data.deposit.validation.ValidationCheckResultRest</class>
                                <class>fr.inra.oresing.domain.application.configuration.Tag</class>
                            </classes>
                            <customTypeMappings>
                                <mapping>java.util.Locale:string</mapping>
                            </customTypeMappings>
                            <outputFile>${project.basedir}/../frontend/src/types/generated/generated-backend-types-module.ts
                            </outputFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
